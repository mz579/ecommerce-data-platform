# ==================================================================
# ecommerce-data-platform 环境变量示例
#
# 使用方法：复制为 .env 后按需修改（.env 已被 git 忽略，禁止提交）。
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
#
# 密码位均为占位符，请填入自己的值；本文件不得存放真实口令。
# ==================================================================

# ---------- MySQL（业务数仓） ----------
# 存放 ODS / DWD / DWS / ADS 四层数仓数据，与元数据库无关。
# MYSQL_HOST / MYSQL_PORT 供宿主机上运行脚本（如 scripts/check_db_health.py）连本机映射端口使用。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce_dw
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_USER=ecom_app
MYSQL_PASSWORD=CHANGE_ME_app_password
# 集成测试专用 schema（必须以 _test 结尾，否则集成测试直接报错）。
# 不设置时默认取 MYSQL_DATABASE + "_test"；pytest 会话自动建库/授权/删除，
# 建库需要上面的 MYSQL_ROOT_PASSWORD。
MYSQL_TEST_DATABASE=ecommerce_dw_test

# ---------- PostgreSQL（Airflow / Superset 元数据库） ----------
# 与业务数仓（MySQL）物理隔离：不同引擎、不同实例、不同凭据。
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 同时被 PostgreSQL 官方镜像使用。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=meta
POSTGRES_USER=meta_app
POSTGRES_PASSWORD=CHANGE_ME_meta_password

# ---------- Airflow（Phase 6 编排） ----------
# 元数据库复用上面的 POSTGRES_*（meta 库），业务库存取仍走 MYSQL_*。
# Airflow 元数据库连接串由 compose 按 POSTGRES_* 拼装，容器内另把 MYSQL_HOST
# 覆盖为 mysql 服务名；DAG/CLI 一律从环境变量取凭据，源码不含口令。
# 生成 Fernet key（至少 32 字节 url-safe base64）：
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_fernet_key_32B_urlsafe_base64
# Web 会话签名密钥（任意高强度随机串，同上生成）
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_webserver_session_secret
# Web 管理员的创建由 airflow-init 幂等完成（airflow users create）
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME_airflow_admin_password
AIRFLOW_WWW_USER_EMAIL=admin@example.com
# Web 宿主机映射端口（可选，默认 8080；改端口后访问 http://localhost:<端口>）
AIRFLOW_UI_PORT=8080

# ---------- Superset（Phase 7 可视化） ----------
# 元数据库：PostgreSQL 独立库 superset_meta（与 Airflow 的 meta 库隔离）。
# SUPERSET_META_DB_URI 由 compose 按 POSTGRES_* 拼装注入 superset_config.py。
SUPERSET_UI_PORT=8088
# 宿主机 API 地址（可选；默认 http://localhost:8088，改 SUPERSET_UI_PORT 时同步）
SUPERSET_UI_URL=http://localhost:8088
SUPERSET_META_DB=superset_meta
SUPERSET_META_USER=superset_meta_app
SUPERSET_META_PASSWORD=CHANGE_ME_superset_meta_password
# Web 会话 / Fernet 加密密钥（任意高强度随机串，同 Airflow 的生成方式）
SUPERSET_SECRET_KEY=CHANGE_ME_superset_secret_key
# 管理员由 superset-init 幂等创建（superset fab create-admin）
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=CHANGE_ME_superset_admin_password
SUPERSET_ADMIN_EMAIL=superset@example.com
# 业务数仓只读账号（Phase 7 权限模型：仅 SELECT，且只落在 ADS 表 + 受控视图。
# 该账号由 scripts/apply_superset_grants.py 创建并授权，见 docs/superset_design.md）
MYSQL_RO_USER=superset_ro
MYSQL_RO_PASSWORD=CHANGE_ME_ro_password
# Superset 容器内访问 MySQL 的服务名/端口
SUPERSET_MYSQL_HOST=mysql
SUPERSET_MYSQL_PORT=3306

# ---------- Phase 9：Kafka + Flink 实时扩展（9.1 基础设施） ----------
# Kafka 宿主机映射端口（容器内 19092；Flink 走内网 kafka:9092）。默认 9092。
KAFKA_PORT=9092
# Flink Web UI（JobManager REST）宿主机端口。默认 8081。
FLINK_UI_PORT=8081
# 单节点 KRaft 集群 ID（22 字符 base64 UUID，非密钥；首次起栈后保持稳定，
# 变更等于换集群，已有 kafka_data 卷将无法识别）。生成：
#   docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
