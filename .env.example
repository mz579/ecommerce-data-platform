# ==================================================================
# ecommerce-data-platform 环境变量示例
#
# 使用方法：复制为 .env 后按需修改（.env 已被 git 忽略，禁止提交）。
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
#
# 密码位均为占位符，请填入自己的值；本文件不得存放真实口令。
# ==================================================================

# ---------- MySQL（业务数仓） ----------
# 存放 ODS / DWD / DWS / ADS 四层数仓数据，与元数据库无关。
# MYSQL_HOST / MYSQL_PORT 供宿主机上运行脚本（如 scripts/check_db_health.py）连本机映射端口使用。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce_dw
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_USER=ecom_app
MYSQL_PASSWORD=CHANGE_ME_app_password

# ---------- PostgreSQL（Airflow / Superset 元数据库） ----------
# 与业务数仓（MySQL）物理隔离：不同引擎、不同实例、不同凭据。
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 同时被 PostgreSQL 官方镜像使用。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=meta
POSTGRES_USER=meta_app
POSTGRES_PASSWORD=CHANGE_ME_meta_password