# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# ---------- 虚拟环境 ----------
.venv/

# ---------- 环境变量与敏感配置 ----------
.env
config/config.yaml

# ---------- 数据文件（不提交原始 / 中间 / 样例数据，只保留目录占位） ----------
data/raw/*
data/staging/*
data/sample/*
!data/raw/.gitkeep
!data/staging/.gitkeep
!data/sample/.gitkeep

# ---------- Node / 前端 ----------
node_modules/
*.tsbuildinfo
web/frontend/dist/

# ---------- 日志 ----------
logs/
*.log

# ---------- Docker 数据（本工程用命名 volume；bind mount 目录一律忽略） ----------
docker/volumes/
*.volume/

# ---------- Flink 依赖 jar（scripts/download_flink_jars.sh 下载，不提交） ----------
docker/flink/lib/*.jar
docker/flink/lib/*.jar.tmp

# ---------- IDE / 系统 ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------- 本地工具 / 规划稿 ----------
.claude/
docs/superpowers/